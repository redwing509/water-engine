    },
    "gas_properties": {
      "value": "Cantera rho, cp, HP-equilibrium T_ad of the fully vaporised charge; k of air (CoolProp) for alpha"
    },
    "liquid": {
      "value": "alcohol rho at 298 K (CoolProp); B = cp (T - T_sat(p)) / h_fg(p) (CoolProp saturation at spark p)"
    },
    "liquid_water": {
      "value": "heat sink Y_wl h_fg/cp evaporated in the preheat zone (upper bound), Zeldovich S ~ exp(-Ea/2RT_ad)",
      "E_a_J_mol": 125000.0
    },
    "sweep_liquid_composition": {
      "value": "liquid at spark has the intake water/alcohol ratio (conservative; Module 09 finds water evaporates first)"
    },
    "sweep_state": {
      "value": "T at spark = mean of Module 09 nominal atomiser values per design point; p from Module 09"
    },
    "spark_energy": {
      "value": "50-100 mJ compared directly with MIE (spark-to-gas transfer efficiency not applied)"
    },
    "turbulence": {
      "value": "not modelled (quiescent correlations)"
    }
  },
