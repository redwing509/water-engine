      "value": "Ballal & Lefebvre (1981) additive evaporation + reaction time",
      "source": "18th Symp. Combust. 321-328"
    },
    "vapour_flame_floor": {
      "value": "S_eff = max(S_BL, S_L(Omega*phi)), M-K methanol phi-parabola ratio",
      "rationale": "pre-vaporised mixture propagates independently when flammable"
    },
    "MIE": {
      "value": "cp rho dT_ad pi/6 d_q^3, d_q^2 = (1-Omega) rho_F D32^2/(rho_g phi ln(1+B)) + (10 alpha/S_L)^2",
